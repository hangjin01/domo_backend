# Docker Compose 실행 시에는 db 컨테이너를 가리킵니다.
DATABASE_URL=postgresql+psycopg2://user:password@db:5432/project_db

# 이메일 인증을 실제로 사용하려면 발급받은 SMTP 앱 비밀번호를 입력합니다.
# 로컬 기동용 기본값입니다. 실제 이메일 인증을 쓰려면 SMTP 값으로 교체하세요.
MAIL_USERNAME=dev@example.com
MAIL_PASSWORD=local-development-only
MAIL_FROM=dev@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# AI 기능을 사용할 때만 설정합니다.
OPENAI_API_KEY=
